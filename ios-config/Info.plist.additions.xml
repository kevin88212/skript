<?xml version="1.0" encoding="UTF-8"?>
<!--
  Diese Einträge müssen in ios/App/App/Info.plist eingefügt werden.
  Das setup-ios.sh Skript macht das automatisch.
-->
<entries>
  <!-- App erscheint vollständig im Vollbild -->
  <key>UIViewControllerBasedStatusBarAppearance</key>
  <false/>

  <!-- Landscape deaktivieren (Hochformat) -->
  <key>UISupportedInterfaceOrientations</key>
  <array>
    <string>UIInterfaceOrientationPortrait</string>
  </array>
</entries>
