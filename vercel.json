{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "installCommand": "npm install",
  "crons": [
    {
      "path": "/api/helfer/cron/morning",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/helfer/cron/midday",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/helfer/cron/evening",
      "schedule": "0 19 * * *"
    }
  ]
}
